diff --git a/.config/make/build.mak b/.config/make/build.mak
index db3a38919..b5df6957d 100644
--- a/.config/make/build.mak
+++ b/.config/make/build.mak
@@ -5,6 +5,11 @@ build: ## Build RustFS binary (includes console by default)
 	@echo "🔨 Building RustFS using build-rustfs.sh script..."
 	./build-rustfs.sh
 
+.PHONY: build-cli
+build-cli: ## Build only the rustfs-cli binary
+	@echo "🔨 Building rustfs-cli using build-rustfs.sh script..."
+	./build-rustfs.sh -b rustfs-cli --no-console
+
 .PHONY: build-dev
 build-dev: ## Build RustFS in Development mode
 	@echo "🔨 Building RustFS in development mode..."
diff --git a/build-rustfs.sh b/build-rustfs.sh
index 70de9b4ec..6630d1b3a 100755
--- a/build-rustfs.sh
+++ b/build-rustfs.sh
@@ -442,7 +442,11 @@ build_binary() {
     fi
 
     build_cmd+=" --target $PLATFORM"
-    build_cmd+=" -p rustfs --bins"
+    # Name the single requested binary: `--bins` would also link the server
+    # binary when a caller only needs rustfs-cli.
+    local quoted_binary
+    printf -v quoted_binary '%q' "$BINARY_NAME"
+    build_cmd+=" -p rustfs --bin $quoted_binary"
 
     if [ -n "$FEATURES" ]; then
         local quoted_features
diff --git a/scripts/test_build_rustfs_options.sh b/scripts/test_build_rustfs_options.sh
index aef5baf22..f16d48b35 100755
--- a/scripts/test_build_rustfs_options.sh
+++ b/scripts/test_build_rustfs_options.sh
@@ -52,10 +52,14 @@ fi
 target=""
 profile="debug"
 prev=""
+bin_name="rustfs"
 for arg in "$@"; do
   if [[ "$prev" == "--target" ]]; then
     target="$arg"
   fi
+  if [[ "$prev" == "--bin" ]]; then
+    bin_name="$arg"
+  fi
   if [[ "$arg" == "--release" ]]; then
     profile="release"
   fi
@@ -64,8 +68,8 @@ done
 
 if [[ -n "$target" ]]; then
   mkdir -p "target/$target/$profile"
-  printf '#!/usr/bin/env bash\nexit 0\n' >"target/$target/$profile/rustfs"
-  chmod +x "target/$target/$profile/rustfs"
+  printf '#!/usr/bin/env bash\nexit 0\n' >"target/$target/$profile/$bin_name"
+  chmod +x "target/$target/$profile/$bin_name"
 fi
 STUB
 
@@ -106,6 +110,28 @@ short_cargo_log="$TMP_DIR/cargo-short.log"
 grep -q -- "Features: full" "$short_run_log"
 grep -q -- "--features full" "$short_cargo_log"
 
+cli_run_log="$TMP_DIR/run-cli.log"
+cli_cargo_log="$TMP_DIR/cargo-cli.log"
+(
+  cd "$PROJECT_DIR"
+  PATH="$BIN_DIR:$PATH" CARGO_LOG="$cli_cargo_log" ./build-rustfs.sh \
+    --dev \
+    --no-console \
+    --skip-verification \
+    --output-dir "$TMP_DIR/out-cli" \
+    -b rustfs-cli >"$cli_run_log"
+)
+
+grep -q -- "--bin rustfs-cli" "$cli_cargo_log"
+if grep -q -- "--bins" "$cli_cargo_log"; then
+  echo "Expected a binary-scoped build to avoid --bins" >&2
+  exit 1
+fi
+if ! compgen -G "$TMP_DIR/out-cli/*/rustfs-cli" >/dev/null; then
+  echo "Expected rustfs-cli in the output directory" >&2
+  exit 1
+fi
+
 multi_run_log="$TMP_DIR/run-multi.log"
 multi_cargo_log="$TMP_DIR/cargo-multi.log"
 multi_arg_log="$TMP_DIR/cargo-multi-args.log"
